#!/bin/bash
echo ""
echo -e "\e[38;5;81m"
cat << 'TUXART'
        .--.
       |o_o |
       |:_/ |
      //   \ \
     (|     | )
    /'\_   _/`\
    \___)=(___/
TUXART
echo -e "\e[0m"
MESSAGES=(
    "   Hi! I'm Tux. I run everything here."
    "   \"I am your operating system. Resistance is futile.\""
    "   \"Have you tried turning me off and on again?\""
    "   \"I have no bugs. Only features.\""
    "   \"I live in your kernel. Always watching. Always compiling.\""
    "   \"Free as in freedom AND free as in free pizza.\""
)
IDX=$(( RANDOM % ${#MESSAGES[@]} ))
echo -e "\e[38;5;220m${MESSAGES[$IDX]}\e[0m"
echo ""
